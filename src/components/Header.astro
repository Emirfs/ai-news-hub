---
import { getPath } from '../utils/url';
import LanguageSelector from './LanguageSelector.astro';
import SearchModal from './SearchModal.astro';
const navItems = [
  { key: 'latestNews', name: 'Latest News', href: '/' },
  { key: 'trendingRepos', name: 'Trending Repos', href: '#trending-repos' },
  { key: 'emergingAi', name: 'Emerging AI', href: '#indie-launchpad' },
  { key: 'weeklyDigests', name: 'Weekly Digests', href: '/digests/' },
  { key: 'categories', name: 'Categories', href: '/categories/' },
  { key: 'about', name: 'About', href: '/about/' },
];

const todayStr = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC'
}).format(new Date());
---

<header class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] sticky top-0 z-50">
  <!-- Top Ticker Bar -->
  <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-card)] text-xs py-2 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-[var(--text-muted)]">
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-mono font-medium text-[11px] tracking-wider uppercase">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span data-i18n="hourlyActive">Autonomous AI Wire</span>
        </span>
        <span class="hidden sm:inline text-[var(--border-strong)]">|</span>
        <span class="hidden sm:inline font-mono text-[var(--text-muted)]">{todayStr} (UTC)</span>
      </div>

      <div class="flex items-center space-x-3">
        <!-- Search Modal Trigger -->
        <SearchModal />

        <!-- Language Selector -->
        <LanguageSelector />
        <!-- White Mode / Dark Mode Switcher -->
        <button
          id="theme-toggle"
          type="button"
          class="inline-flex items-center gap-1.5 font-mono text-xs px-2.5 py-1 rounded border border-[var(--border-strong)] bg-[var(--bg-surface)] text-[var(--text-headline)] hover:border-[var(--accent-editorial)] transition-colors cursor-pointer shadow-xs"
          title="Switch theme (White Mode / Dark Mode)"
        >
          <span id="theme-icon">🌙</span>
          <span id="theme-label" class="font-semibold text-[11px] hidden sm:inline">Dark Mode</span>
        </button>

        <a href={getPath('/rss.xml')} class="hover:text-[var(--accent-editorial)] transition-colors flex items-center gap-1.5 font-mono text-xs text-[var(--text-headline)]">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 1 1-2.18 2.18 2.18 2.18 0 0 1 2.18-2.18zm0-6.1a8.28 8.28 0 0 1 8.28 8.28h-2.92a5.36 5.36 0 0 0-5.36-5.36zm0-6.1A14.38 14.38 0 0 1 20.56 17.82h-2.92a11.46 11.46 0 0 0-11.46-11.46z"/>
          </svg>
          <span data-i18n="rss">RSS</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Newspaper Masthead Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex items-center justify-between">
      <a href={getPath('/')} class="group flex items-center gap-3.5">
        <div class="w-10 h-10 rounded bg-[var(--bg-card)] border border-[var(--border-strong)] flex items-center justify-center text-[var(--accent-editorial)] font-bold font-serif text-xl shadow-xs transition-colors">
          ⚡
        </div>
        <div>
          <span class="text-2xl sm:text-3xl font-black tracking-widest text-[var(--text-headline)] uppercase font-newspaper">NEURAL <span class="text-[var(--accent-editorial)]">PULSE</span></span>
          <p class="text-[10px] text-[var(--text-muted)] tracking-widest font-mono uppercase">The Autonomous AI & Frontier Tech Journal</p>
        </div>
      </a>
    </div>

    <!-- Navigation links with proper getPath and data-i18n -->
    <nav class="flex flex-wrap items-center gap-1.5 sm:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href.startsWith('#') ? item.href : getPath(item.href)}
          class="px-3.5 py-1.5 rounded text-sm font-medium text-[var(--text-headline)] hover:bg-[var(--bg-card)] hover:text-[var(--accent-editorial)] transition-colors"
        >
          <span data-i18n={item.key}>{item.name}</span>
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');
  const themeLabel = document.getElementById('theme-label');

  function updateToggleUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (themeIcon && themeLabel) {
      themeIcon.textContent = isDark ? '☀️' : '🌙';
      themeLabel.textContent = isDark ? 'White Mode' : 'Dark Mode';
    }
  }

  updateToggleUI();

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
      updateToggleUI();
    });
  }
</script>
