---
const languages = [
  { code: 'en', name: 'English', flag: '🇬🇧' },
  { code: 'tr', name: 'Türkçe', flag: '🇹🇷' },
  { code: 'es', name: 'Español', flag: '🇪🇸' },
  { code: 'zh', name: '中文', flag: '🇨🇳' },
  { code: 'it', name: 'Italiano', flag: '🇮🇹' },
  { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
];
---

<div class="relative inline-block text-left" id="lang-menu-container">
  <button
    id="lang-menu-button"
    type="button"
    class="inline-flex items-center gap-1.5 font-mono text-xs px-2.5 py-1 rounded border border-[var(--border-strong)] bg-[var(--bg-surface)] text-[var(--text-headline)] hover:border-[var(--accent-editorial)] transition-colors cursor-pointer shadow-xs"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span id="current-lang-flag">🌐</span>
    <span id="current-lang-label" class="font-semibold text-[11px]">EN</span>
    <svg class="w-3 h-3 text-[var(--text-muted)] ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="lang-dropdown"
    class="hidden absolute right-0 mt-2 w-36 rounded-md shadow-lg bg-[var(--bg-surface)] border border-[var(--border-strong)] ring-1 ring-black/5 z-50 py-1 font-mono text-xs"
    role="menu"
    aria-orientation="vertical"
  >
    {languages.map((lang) => (
      <button
        type="button"
        data-lang={lang.code}
        data-flag={lang.flag}
        data-name={lang.name}
        class="lang-option w-full text-left px-3 py-1.5 flex items-center gap-2 text-[var(--text-headline)] hover:bg-[var(--bg-card)] hover:text-[var(--accent-editorial)] transition-colors cursor-pointer"
        role="menuitem"
      >
        <span>{lang.flag}</span>
        <span>{lang.name}</span>
      </button>
    ))}
  </div>
</div>

<script is:inline>
  const langBtn = document.getElementById('lang-menu-button');
  const langDropdown = document.getElementById('lang-dropdown');

  if (langBtn && langDropdown) {
    langBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      langDropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      langDropdown.classList.add('hidden');
    });

    document.querySelectorAll('.lang-option').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const langCode = btn.getAttribute('data-lang');
        if (window.setSiteLanguage) {
          window.setSiteLanguage(langCode);
        } else {
          localStorage.setItem('site_lang', langCode);
        }
        langDropdown.classList.add('hidden');
      });
    });
  }
</script>
