---
import reposData from '../data/trending_repos.json';

interface Repo {
  name: string;
  url: string;
  stars: number;
  forks: number;
  description: string;
  language: string;
  tag: string;
  owner_avatar?: string;
}

const repos: Repo[] = reposData as Repo[];

function formatNumber(num: number): string {
  if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'k';
  }
  return num.toString();
}
---

<section class="my-14 border-t border-b border-[var(--border-subtle)] py-10">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider mb-1">
        <span>⚡</span> Open-Source Radar
      </div>
      <h2 class="text-2xl font-bold font-newspaper text-[var(--text-headline)]">
        Trending & Novel AI Repositories
      </h2>
    </div>
    <div class="text-xs font-mono text-[var(--text-muted)]">
      Curated directly from GitHub telemetry • Updated hourly
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {repos.map((repo) => (
      <a
        href={repo.url}
        target="_blank"
        rel="noopener noreferrer"
        class="p-4 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--accent-editorial)] transition-all flex flex-col justify-between group"
      >
        <div>
          <!-- Tag & Stars -->
          <div class="flex items-center justify-between gap-2 mb-2 text-xs font-mono">
            <span class="px-2 py-0.5 rounded border border-[var(--border-strong)] bg-[var(--badge-bg)] text-[var(--badge-text)] text-[10px] font-semibold">
              {repo.tag}
            </span>
            <span class="text-[var(--accent-secondary)] font-bold flex items-center gap-1">
              ★ {formatNumber(repo.stars)}
            </span>
          </div>

          <!-- Repo Name -->
          <h3 class="text-sm font-bold font-mono text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors break-words mb-2">
            {repo.name}
          </h3>

          <!-- Description -->
          <p class="text-xs text-[var(--text-body)] line-clamp-3 leading-relaxed mb-3">
            {repo.description}
          </p>
        </div>

        <!-- Language & External Link Indicator -->
        <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] font-mono text-[var(--text-muted)]">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>{repo.language}</span>
          </span>
          <span class="group-hover:text-[var(--accent-editorial)] font-semibold inline-flex items-center gap-0.5">
            GitHub <span class="text-xs">↗</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
