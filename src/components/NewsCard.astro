---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  sourceName?: string;
  sourceUrl?: string;
  keyTakeaways?: string[];
  isWeeklyDigest?: boolean;
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  tags = [],
  sourceName,
  sourceUrl,
  keyTakeaways = [],
  isWeeklyDigest = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);

// Category colors - Zero Blue!
const categoryColorMap: Record<string, string> = {
  'LLMs & Foundation Models': 'bg-neutral-800 text-neutral-200 border-neutral-700',
  'Robotics & Hardware': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  'AI Research': 'bg-purple-500/10 text-purple-300 border-purple-500/30',
  'Weekly Digest': 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  'Open Source AI': 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
  'Industry & Startups': 'bg-neutral-800 text-neutral-300 border-neutral-700',
};

const badgeClass = categoryColorMap[category] || 'bg-neutral-800 text-neutral-300 border-neutral-700';
---

<article class="group relative flex flex-col justify-between rounded-lg bg-[#141416] border border-neutral-800 p-6 hover:border-neutral-700 hover:bg-[#18181b] transition-all duration-150">
  <div>
    <!-- Meta bar -->
    <div class="flex items-center justify-between gap-2 mb-3 text-xs font-mono">
      <span class={`inline-block px-2.5 py-0.5 rounded border ${badgeClass} font-semibold uppercase tracking-wider text-[10px]`}>
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-neutral-400">
        {formattedDate}
      </time>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors leading-snug mb-3 font-newspaper">
      <a href={`/news/${slug}`} class="focus:outline-none">
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-neutral-300 line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Key Takeaway Preview (if available) -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="relative z-10 mb-4 p-2.5 rounded bg-[#0d0d0f] border border-neutral-800 text-xs text-neutral-300">
        <span class="font-mono text-amber-400 font-bold block mb-1">⚡ Key Signal:</span>
        <p class="line-clamp-2 text-neutral-300">
          • {keyTakeaways[0]}
        </p>
      </div>
    )}
  </div>

  <!-- Bottom Info -->
  <div class="relative z-10 pt-3 border-t border-neutral-800/80 flex items-center justify-between text-xs text-neutral-400">
    <div class="flex items-center gap-2">
      {sourceName && (
        <span class="font-mono text-neutral-400">
          Source: <span class="text-neutral-200 font-medium">{sourceName}</span>
        </span>
      )}
    </div>
    <span class="text-amber-400 font-mono group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
      Read Analysis →
    </span>
  </div>
</article>
