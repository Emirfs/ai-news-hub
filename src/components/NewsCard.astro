---
import { getPath } from '../utils/url';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  sourceName?: string;
  sourceUrl?: string;
  keyTakeaways?: string[];
  isWeeklyDigest?: boolean;
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  tags = [],
  sourceName,
  sourceUrl,
  keyTakeaways = [],
  isWeeklyDigest = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);

const articleUrl = getPath(`/news/${slug}/`);
---

<article class="group relative flex flex-col justify-between rounded-lg bg-[var(--bg-card)] border border-[var(--border-subtle)] p-6 hover:border-[var(--border-strong)] transition-all duration-150">
  <div>
    <!-- Meta bar -->
    <div class="flex items-center justify-between gap-2 mb-3 text-xs font-mono">
      <span class="inline-block px-2.5 py-0.5 rounded border border-[var(--border-strong)] bg-[var(--badge-bg)] text-[var(--badge-text)] font-semibold uppercase tracking-wider text-[10px]">
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-[var(--text-muted)]">
        {formattedDate}
      </time>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors leading-snug mb-3 font-newspaper">
      <a href={articleUrl} class="focus:outline-none">
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-[var(--text-body)] line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Key Takeaway Preview (if available) -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="relative z-10 mb-4 p-2.5 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-xs text-[var(--text-body)]">
        <span class="font-mono text-[var(--accent-editorial)] font-bold block mb-1">⚡ Key Signal:</span>
        <p class="line-clamp-2 text-[var(--text-body)]">
          • {keyTakeaways[0]}
        </p>
      </div>
    )}
  </div>

  <!-- Bottom Info -->
  <div class="relative z-10 pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs text-[var(--text-muted)]">
    <div class="flex items-center gap-2">
      {sourceName && (
        <span class="font-mono text-[var(--text-muted)]">
          Source: <span class="text-[var(--text-headline)] font-medium">{sourceName}</span>
        </span>
      )}
    </div>
    <span class="text-[var(--accent-editorial)] font-mono group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
      Read Analysis →
    </span>
  </div>
</article>
