---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  sourceName?: string;
  sourceUrl?: string;
  keyTakeaways?: string[];
  isWeeklyDigest?: boolean;
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  tags = [],
  sourceName,
  sourceUrl,
  keyTakeaways = [],
  isWeeklyDigest = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);

// Category colors
const categoryColorMap: Record<string, string> = {
  'LLMs & Foundation Models': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30',
  'Robotics & Hardware': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  'AI Research': 'bg-purple-500/10 text-purple-400 border-purple-500/30',
  'Weekly Digest': 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  'Industry & Startups': 'bg-blue-500/10 text-blue-400 border-blue-500/30',
};

const badgeClass = categoryColorMap[category] || 'bg-slate-800 text-slate-300 border-slate-700';
---

<article class="group relative flex flex-col justify-between rounded-xl bg-[#111827]/70 border border-[#1e293b] p-6 hover:border-cyan-500/40 hover:bg-[#141f33]/80 transition-all duration-200 shadow-sm hover:shadow-cyan-950/20">
  <div>
    <!-- Meta bar -->
    <div class="flex items-center justify-between gap-2 mb-3 text-xs font-mono">
      <span class={`inline-block px-2.5 py-0.5 rounded-full border ${badgeClass} font-semibold uppercase tracking-wider text-[11px]`}>
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-slate-400">
        {formattedDate}
      </time>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug mb-3">
      <a href={`/news/${slug}`} class="focus:outline-none">
        <span class="absolute inset-0 z-0"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-sm text-slate-300 line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>

    <!-- Key Takeaway Preview (if available) -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="relative z-10 mb-4 p-2.5 rounded-lg bg-[#0c121e] border border-slate-800/80 text-xs text-slate-300">
        <span class="font-mono text-cyan-400 font-bold block mb-1">⚡ Key Signal:</span>
        <p class="line-clamp-2 text-slate-300">
          • {keyTakeaways[0]}
        </p>
      </div>
    )}
  </div>

  <!-- Bottom Info -->
  <div class="relative z-10 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
    <div class="flex items-center gap-2">
      {sourceName && (
        <span class="font-mono text-slate-400">
          Source: <span class="text-slate-200 font-medium">{sourceName}</span>
        </span>
      )}
    </div>
    <span class="text-cyan-400 font-mono group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
      Read Analysis →
    </span>
  </div>
</article>
