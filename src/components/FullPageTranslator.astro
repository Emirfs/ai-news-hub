---
import { translations } from '../utils/i18n';
---

<!-- Embedded dictionary for instant client-side full page translation -->
<script define:vars={{ translations }}>
  function applyFullPageTranslation(lang) {
    if (!lang || !translations[lang]) return;

    const dict = translations[lang];

    // 1. Translate all elements with data-i18n attribute
    document.querySelectorAll('[data-i18n]').forEach(el => {
      const key = el.getAttribute('data-i18n');
      if (key && dict[key]) {
        el.textContent = dict[key];
      }
    });

    // 2. Translate Category pills & badges
    const categoryMap = {
      'LLMs & Foundation Models': dict.catLLM,
      'AI Research': dict.catResearch,
      'Robotics & Hardware': dict.catRobotics,
      'Open Source AI': dict.catOpenSource,
      'Weekly Digest': dict.catDigest,
      'Industry & Startups': dict.catIndustry,
    };

    document.querySelectorAll('[data-category]').forEach(el => {
      const origCat = el.getAttribute('data-category');
      if (origCat && categoryMap[origCat]) {
        el.textContent = categoryMap[origCat];
      }
    });

    // 3. Update HTML lang attribute
    document.documentElement.setAttribute('lang', lang);

    // 4. Update Header Dropdown UI
    const flagSpan = document.getElementById('current-lang-flag');
    const labelSpan = document.getElementById('current-lang-label');
    const flagMap = {
      'en': { flag: '🇬🇧', label: 'EN' },
      'tr': { flag: '🇹🇷', label: 'TR' },
      'es': { flag: '🇪🇸', label: 'ES' },
      'zh': { flag: '🇨🇳', label: 'ZH' },
      'it': { flag: '🇮🇹', label: 'IT' },
      'de': { flag: '🇩🇪', label: 'DE' }
    };

    if (flagMap[lang]) {
      if (flagSpan) flagSpan.textContent = flagMap[lang].flag;
      if (labelSpan) labelSpan.textContent = flagMap[lang].label;
    }

    // 5. Broadcast to any specific page handlers (like article reader)
    window.dispatchEvent(new CustomEvent('pageLanguageChanged', { detail: { lang } }));
  }

  // Global helper accessible from all components
  window.setSiteLanguage = function(lang) {
    localStorage.setItem('site_lang', lang);
    applyFullPageTranslation(lang);
  };

  // Run on DOM content loaded and restore saved language
  document.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem('site_lang') || 'en';
    if (saved && saved !== 'en') {
      applyFullPageTranslation(saved);
    }
  });
</script>
