---
import { getPath } from '../utils/url';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  sourceName?: string;
  keyTakeaways?: string[];
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  sourceName,
  keyTakeaways = [],
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);

const articleUrl = getPath(`/news/${slug}/`);
---

<section class="relative overflow-hidden rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-card)] p-6 sm:p-9 lg:p-11 mb-10 shadow-sm" data-news-id={slug}>
  <div class="absolute inset-y-0 left-0 w-1.5 bg-[var(--accent-editorial)]" aria-hidden="true"></div>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class:list={['space-y-5', keyTakeaways.length > 0 ? 'lg:col-span-8' : 'lg:col-span-12']}>
      <div class="flex items-center gap-2.5 text-xs font-mono">
        <span class="px-2 py-0.5 rounded bg-[var(--badge-bg)] text-[var(--accent-editorial)] border border-[var(--border-strong)] font-bold uppercase tracking-wider text-[11px]">
          Featured story
        </span>
        <span class="text-[var(--text-muted)]">{category}</span>
        <span class="text-[var(--border-strong)]">•</span>
        <span class="text-[var(--text-muted)]">{formattedDate}</span>
      </div>

      <h1 class="max-w-4xl text-3xl sm:text-5xl lg:text-6xl font-bold text-[var(--text-headline)] tracking-tight leading-[1.12] font-newspaper hover:text-[var(--accent-editorial)] transition-colors">
        <a href={articleUrl} data-news-title>
          {title}
        </a>
      </h1>

      <p class="max-w-3xl text-base sm:text-lg text-[var(--text-body)] leading-[1.75] font-sans" data-news-desc>
        {description}
      </p>

      <div class="pt-2 flex flex-wrap items-center gap-4">
        <a
          href={articleUrl}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[var(--text-headline)] hover:opacity-90 text-[var(--bg-primary)] font-semibold text-sm transition-opacity"
        >
          Read story
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        {sourceName && (
          <span class="text-xs font-mono text-[var(--text-muted)]">
            Source attribution: <strong class="text-[var(--text-headline)]">{sourceName}</strong>; not independently verified.
          </span>
        )}
      </div>
    </div>

    <!-- Takeaways Box (Sidebar on desktop) -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="lg:col-span-4 rounded-lg bg-[var(--bg-card)] border border-[var(--border-subtle)] p-5 space-y-3.5">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider border-b border-[var(--border-subtle)] pb-2">
          <span>⚡</span> Executive Highlights
        </div>
        <ul class="space-y-3 text-xs sm:text-sm text-[var(--text-body)]">
          {keyTakeaways.slice(0, 3).map((item) => (
            <li class="flex items-start gap-2.5 leading-relaxed">
              <span class="text-[var(--accent-editorial)] font-bold mt-0.5">▸</span>
              <span data-news-takeaway>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
