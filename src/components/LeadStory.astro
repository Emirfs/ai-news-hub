---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  sourceName?: string;
  keyTakeaways?: string[];
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  sourceName,
  keyTakeaways = [],
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);
---

<section class="relative rounded-2xl bg-gradient-to-br from-[#111c30] via-[#0f172a] to-[#0a0f1d] border border-cyan-500/30 p-6 sm:p-10 shadow-2xl shadow-cyan-950/30 mb-12 overflow-hidden">
  <!-- Subtle decorative ambient glow -->
  <div class="absolute -top-24 -right-24 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-8 space-y-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 text-xs font-mono font-bold uppercase tracking-wider">
          ★ LEAD HEADLINE
        </span>
        <span class="text-xs font-mono text-slate-400">{category}</span>
        <span class="text-slate-600">•</span>
        <span class="text-xs font-mono text-slate-400">{formattedDate}</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight hover:text-cyan-300 transition-colors">
        <a href={`/news/${slug}`}>
          {title}
        </a>
      </h1>

      <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl">
        {description}
      </p>

      <div class="pt-2 flex flex-wrap items-center gap-4">
        <a
          href={`/news/${slug}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-sm transition-all shadow-lg shadow-cyan-500/20 hover:scale-[1.02]"
        >
          Read Full Analysis
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        {sourceName && (
          <span class="text-xs font-mono text-slate-400">
            Primary Feed: <strong class="text-slate-200">{sourceName}</strong>
          </span>
        )}
      </div>
    </div>

    <!-- Takeaways Box (Sidebar on desktop) -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="lg:col-span-4 rounded-xl bg-[#090d16]/90 border border-cyan-500/20 p-5 space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider border-b border-slate-800 pb-2">
          <span>⚡</span> Executive Highlights
        </div>
        <ul class="space-y-2.5 text-xs text-slate-300">
          {keyTakeaways.slice(0, 3).map((item) => (
            <li class="flex items-start gap-2 leading-relaxed">
              <span class="text-cyan-400 font-mono mt-0.5">▸</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
