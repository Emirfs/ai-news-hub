---
import { getPath } from '../utils/url';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  sourceName?: string;
  keyTakeaways?: string[];
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  sourceName,
  keyTakeaways = [],
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);

const articleUrl = getPath(`/news/${slug}/`);
---

<article class="py-6 border-b border-[var(--border-subtle)] group flex flex-col md:flex-row md:items-baseline md:justify-between gap-4 transition-colors hover:bg-[var(--bg-card)] px-3 -mx-3 rounded-lg" data-news-id={slug}>
  <div class="space-y-2 flex-grow max-w-3xl">
    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono">
      <span class="px-2 py-0.5 rounded border border-[var(--border-strong)] bg-[var(--badge-bg)] text-[var(--badge-text)] text-[10px] uppercase font-bold tracking-wider">
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-[var(--text-muted)]">
        {formattedDate}
      </time>
      {sourceName && (
        <>
          <span class="text-[var(--border-strong)]">•</span>
          <span class="text-[var(--text-muted)]">
            Original source: <span class="text-[var(--text-headline)]">{sourceName}</span>
          </span>
        </>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-bold text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors leading-snug font-newspaper">
      <a href={articleUrl} class="focus:outline-none" data-news-title>
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-sm sm:text-base text-[var(--text-body)] leading-relaxed font-sans" data-news-desc>
      {description}
    </p>

    <!-- Key Takeaway preview if present -->
    {keyTakeaways.length > 0 && (
      <div class="pt-1 text-xs text-[var(--text-muted)] flex items-start gap-1.5 font-mono">
        <span class="text-[var(--accent-editorial)] font-bold">Reported takeaway:</span>
        <span class="text-[var(--text-body)]" data-news-takeaway>{keyTakeaways[0]}</span>
      </div>
    )}
  </div>

  <!-- Read Action Link -->
  <div class="shrink-0 self-start md:self-center pt-2 md:pt-0">
    <a
      href={articleUrl}
      class="inline-flex items-center gap-1.5 text-xs font-mono text-[var(--text-muted)] group-hover:text-[var(--accent-editorial)] transition-colors uppercase tracking-wider font-semibold py-1 px-2.5 rounded border border-[var(--border-subtle)] group-hover:border-[var(--accent-editorial)] bg-[var(--bg-surface)]"
    >
      <span>Read</span>
      <span class="text-[var(--accent-editorial)] group-hover:translate-x-0.5 transition-transform">→</span>
    </a>
  </div>
</article>
