---
interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date;
  category: string;
  sourceName?: string;
  sourceUrl?: string;
  keyTakeaways?: string[];
  isWeeklyDigest?: boolean;
}

const {
  title,
  description,
  slug,
  pubDate,
  category,
  sourceName,
  sourceUrl,
  keyTakeaways = [],
  isWeeklyDigest = false,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
}).format(pubDate);

// Category tag styles (zero blue!)
const categoryBadgeClass: Record<string, string> = {
  'LLMs & Foundation Models': 'text-amber-300/90 border-amber-500/30 bg-amber-500/10',
  'Robotics & Hardware': 'text-emerald-300/90 border-emerald-500/30 bg-emerald-500/10',
  'AI Research': 'text-purple-300/90 border-purple-500/30 bg-purple-500/10',
  'Open Source AI': 'text-teal-300/90 border-teal-500/30 bg-teal-500/10',
  'Weekly Digest': 'text-amber-400 border-amber-500/40 bg-amber-500/15',
  'Industry & Startups': 'text-neutral-300 border-neutral-700 bg-neutral-800',
};

const badgeClass = categoryBadgeClass[category] || 'text-neutral-300 border-neutral-700 bg-neutral-800';
---

<article class="py-6 border-b border-neutral-800/80 group flex flex-col md:flex-row md:items-baseline md:justify-between gap-4 transition-colors hover:bg-neutral-900/30 px-3 -mx-3 rounded-lg">
  <div class="space-y-2 flex-grow max-w-3xl">
    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono">
      <span class={`px-2 py-0.5 rounded border text-[10px] uppercase font-bold tracking-wider ${badgeClass}`}>
        {category}
      </span>
      <time datetime={pubDate.toISOString()} class="text-neutral-400">
        {formattedDate}
      </time>
      {sourceName && (
        <>
          <span class="text-neutral-600">•</span>
          <span class="text-neutral-400">
            Source: <span class="text-neutral-300">{sourceName}</span>
          </span>
        </>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-amber-400 transition-colors leading-snug font-editorial">
      <a href={`/news/${slug}`} class="focus:outline-none">
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-sm sm:text-base text-neutral-300 leading-relaxed font-sans">
      {description}
    </p>

    <!-- Key Takeaway preview if present -->
    {keyTakeaways && keyTakeaways.length > 0 && (
      <div class="pt-1 text-xs text-neutral-400 flex items-start gap-1.5 font-mono">
        <span class="text-amber-400 font-bold">Signal:</span>
        <span class="text-neutral-300 line-clamp-1">{keyTakeaways[0]}</span>
      </div>
    )}
  </div>

  <!-- Read Action Link -->
  <div class="shrink-0 self-start md:self-center pt-2 md:pt-0">
    <a
      href={`/news/${slug}`}
      class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-400 group-hover:text-amber-400 transition-colors uppercase tracking-wider font-semibold py-1 px-2.5 rounded border border-neutral-800 group-hover:border-amber-500/40 bg-neutral-900/60"
    >
      <span>Read</span>
      <span class="text-amber-400 group-hover:translate-x-0.5 transition-transform">→</span>
    </a>
  </div>
</article>
