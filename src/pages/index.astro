---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import NewsListItem from '../components/NewsListItem.astro';
import NewsCard from '../components/NewsCard.astro';

const allNews = await getCollection('news');

// Sort by date descending
const sortedNews = allNews.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const digests = sortedNews.filter((item) => item.data.isWeeklyDigest);
const regularArticles = sortedNews.filter((item) => !item.data.isWeeklyDigest);

const leadStory = regularArticles[0];
const secondaryStories = regularArticles.slice(1, 3);
const feedArticles = regularArticles.slice(3);

const categories = Array.from(new Set(allNews.map((item) => item.data.category)));
---

<BaseLayout>
  <!-- Newsroom Status Ticker -->
  <section class="mb-10 py-2.5 px-4 rounded bg-[#121316] border border-neutral-800/80 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-neutral-400">
    <div class="flex items-center gap-5">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-neutral-400">Autonomous Desk:</span>
        <span class="text-white font-medium">Hourly Verification Active</span>
      </div>
      <div class="hidden sm:inline-block text-neutral-600">|</div>
      <div class="hidden sm:flex items-center gap-2">
        <span>Monitored:</span>
        <span class="text-neutral-300">OpenAI, Anthropic, DeepSeek, Google Gemini, arXiv</span>
      </div>
    </div>
    <div>
      Total Indexed Dispatches: <strong class="text-amber-400 font-semibold">{allNews.length}</strong>
    </div>
  </section>

  <!-- 1. Top Lead Story -->
  {leadStory && (
    <LeadStory
      title={leadStory.data.title}
      description={leadStory.data.description}
      slug={leadStory.id.replace(/\.md$/, '')}
      pubDate={leadStory.data.pubDate}
      category={leadStory.data.category}
      sourceName={leadStory.data.sourceName}
      keyTakeaways={leadStory.data.keyTakeaways}
    />
  )}

  <!-- 2. Secondary Editorial Highlights (2-column layout) -->
  {secondaryStories.length > 0 && (
    <section class="mb-12 border-b border-neutral-800 pb-12">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-400 flex items-center gap-2">
          <span>◆</span> Frontier Highlights
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {secondaryStories.map((story) => (
          <NewsCard
            title={story.data.title}
            description={story.data.description}
            slug={story.id.replace(/\.md$/, '')}
            pubDate={story.data.pubDate}
            category={story.data.category}
            tags={story.data.tags}
            sourceName={story.data.sourceName}
            sourceUrl={story.data.sourceUrl}
            keyTakeaways={story.data.keyTakeaways}
          />
        ))}
      </div>
    </section>
  )}

  <!-- 3. Weekly Digest Spotlight (if any digest exists) -->
  {digests.length > 0 && (
    <section class="mb-12 p-6 rounded-lg bg-[#141519] border border-amber-500/30">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-2 font-mono text-sm font-bold text-amber-400 uppercase tracking-wider">
          <span>📋</span>
          Latest Executive Briefing
        </div>
        <a href="/digests" class="text-xs font-mono text-amber-400 hover:text-amber-300 flex items-center gap-1 font-semibold">
          View All Weekly Briefings →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {digests.slice(0, 2).map((digest) => (
          <a
            href={`/news/${digest.id.replace(/\.md$/, '')}`}
            class="p-4 rounded bg-[#0e0f11] border border-neutral-800 hover:border-amber-500/50 transition-colors block group"
          >
            <div class="text-xs font-mono text-amber-400 mb-1">
              {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(digest.data.pubDate)}
            </div>
            <h4 class="text-base font-bold text-white group-hover:text-amber-300 transition-colors line-clamp-2 font-editorial">
              {digest.data.title}
            </h4>
            <p class="text-xs text-neutral-400 line-clamp-2 mt-2 font-sans">
              {digest.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- 4. Category Filter Navigation -->
  <section class="mb-6 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none border-b border-neutral-800 pb-3">
    <span class="text-xs font-mono uppercase text-neutral-400 font-semibold mr-1 shrink-0">Filter:</span>
    <a
      href="/"
      class="px-3 py-1 rounded text-xs font-mono font-medium bg-white text-black transition-colors shrink-0"
    >
      All Dispatches ({allNews.length})
    </a>
    {categories.map((cat) => (
      <a
        href={`/categories/${encodeURIComponent(cat)}`}
        class="px-3 py-1 rounded text-xs font-mono font-medium bg-neutral-900 hover:bg-neutral-800 text-neutral-300 hover:text-white border border-neutral-800 transition-colors shrink-0"
      >
        {cat}
      </a>
    ))}
  </section>

  <!-- 5. Chronological News Stream (High Readability List) -->
  <section class="divide-y divide-neutral-800/80">
    <div class="flex items-center justify-between pb-3">
      <h2 class="text-lg font-bold font-editorial text-white tracking-wide flex items-center gap-2">
        <span class="text-amber-400">⚡</span> Chronological Wire Feed
      </h2>
      <span class="text-xs font-mono text-neutral-400">
        {feedArticles.length} Stories Listed
      </span>
    </div>

    <div class="space-y-1">
      {feedArticles.map((article) => (
        <NewsListItem
          title={article.data.title}
          description={article.data.description}
          slug={article.id.replace(/\.md$/, '')}
          pubDate={article.data.pubDate}
          category={article.data.category}
          sourceName={article.data.sourceName}
          sourceUrl={article.data.sourceUrl}
          keyTakeaways={article.data.keyTakeaways}
          isWeeklyDigest={article.data.isWeeklyDigest}
        />
      ))}
    </div>
  </section>
</BaseLayout>
