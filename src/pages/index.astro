---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import NewsListItem from '../components/NewsListItem.astro';
import TrendingSidebar from '../components/TrendingSidebar.astro';
import TrendingRepos from '../components/TrendingRepos.astro';
import EmergingRepos from '../components/EmergingRepos.astro';
import { getPath } from '../utils/url';

const allNews = await getCollection('news');

// Sort by date descending
const sortedNews = allNews.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const digests = sortedNews.filter((item) => item.data.isWeeklyDigest);
const regularArticles = sortedNews.filter((item) => !item.data.isWeeklyDigest);

const leadStory = regularArticles[0];
const trendingArticles = regularArticles.slice(1, 6);
const wireArticles = sortedNews;

const categories = Array.from(new Set(allNews.map((item) => item.data.category)));

// Build news translations map for client-side live homepage translation
const newsTranslations: Record<string, any> = {};
allNews.forEach((item) => {
  const slug = item.id.replace(/\.md$/, '');
  newsTranslations[slug] = {
    en: {
      title: item.data.title,
      description: item.data.description,
      keyTakeaways: item.data.keyTakeaways || [],
    },
    ...(item.data.translations || {}),
  };
});
---

<BaseLayout>
  <!-- Newsroom Status Bar -->
  <section class="mb-10 py-2.5 px-4 rounded bg-[var(--bg-card)] border border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[var(--text-muted)]">
    <div class="flex items-center gap-5">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-[var(--text-muted)]" data-i18n="wireStatus">News Desk:</span>
        <span class="text-[var(--text-headline)] font-medium" data-i18n="hourlyActive">Hourly Autonomous Wire</span>
      </div>
      <div class="hidden sm:inline-block text-[var(--border-strong)]">|</div>
      <div class="hidden sm:flex items-center gap-2">
        <span data-i18n="monitoredProviders">Providers Monitored:</span>
        <span class="text-[var(--text-headline)] font-medium">OpenAI, Anthropic, DeepSeek, Google Gemini</span>
      </div>
    </div>
    <div>
      <span data-i18n="totalIndexed">Total Indexed Dispatches:</span> <strong class="text-[var(--accent-editorial)] font-semibold">{allNews.length}</strong>
    </div>
  </section>

  <!-- Front Page Editorial Grid (2/3 Lead Story + 1/3 Top 5 Trending Sidebar) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 border-b border-[var(--border-subtle)] pb-12 mb-12">
    <!-- Main Column: Lead Headline -->
    <div class="lg:col-span-8">
      {leadStory && (
        <LeadStory
          title={leadStory.data.title}
          description={leadStory.data.description}
          slug={leadStory.id.replace(/\.md$/, '')}
          pubDate={leadStory.data.pubDate}
          category={leadStory.data.category}
          sourceName={leadStory.data.sourceName}
          keyTakeaways={leadStory.data.keyTakeaways}
        />
      )}
    </div>

    <!-- Right Sidebar: Numbered Top 5 Trending Stories (like NYTimes & The Verge) -->
    <div class="lg:col-span-4 lg:border-l lg:border-[var(--border-subtle)] lg:pl-8">
      <TrendingSidebar articles={trendingArticles} />
    </div>
  </div>

  <!-- Open-Source Radar: Trending Major AI Repositories -->
  <div id="trending-repos">
    <TrendingRepos />
  </div>

  <!-- Indie AI Launchpad: Emerging & Actively Maintained Repositories -->
  <div id="indie-launchpad">
    <EmergingRepos />
  </div>

  <!-- Weekly Digest Spotlight (if any digest exists) -->
  {digests.length > 0 && (
    <section class="my-12 p-6 rounded-lg bg-[var(--bg-card)] border border-[var(--border-strong)]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-2 font-mono text-sm font-bold text-[var(--accent-editorial)] uppercase tracking-wider">
          <span>📋</span>
          <span data-i18n="weeklyDigestTitle">Latest Executive Briefing</span>
        </div>
        <a href={getPath('/digests/')} class="text-xs font-mono text-[var(--accent-editorial)] hover:opacity-80 flex items-center gap-1 font-semibold" data-i18n="viewAllWeekly">
          View All Weekly Briefings →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {digests.slice(0, 2).map((digest) => (
          <a
            href={getPath(`/news/${digest.id.replace(/\.md$/, '')}/`)}
            class="p-4 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--accent-editorial)] transition-colors block group"
            data-news-id={digest.id.replace(/\.md$/, '')}
          >
            <div class="text-xs font-mono text-[var(--accent-editorial)] mb-1">
              {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(digest.data.pubDate)}
            </div>
            <h4 class="text-base font-bold text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors line-clamp-2 font-newspaper" data-news-title>
              {digest.data.title}
            </h4>
            <p class="text-xs text-[var(--text-muted)] line-clamp-2 mt-2 font-sans" data-news-desc>
              {digest.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Category Filter Tabs -->
  <section class="mb-6 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none border-b border-[var(--border-subtle)] pb-3">
    <span class="text-xs font-mono uppercase text-[var(--text-muted)] font-semibold mr-1 shrink-0" data-i18n="filterWire">Filter Wire:</span>
    <a
      href={getPath('/')}
      class="px-3 py-1 rounded text-xs font-mono font-medium bg-[var(--text-headline)] text-[var(--bg-primary)] transition-colors shrink-0"
    >
      <span data-i18n="allDispatches">All Dispatches</span> ({allNews.length})
    </a>
    {categories.map((cat) => (
      <a
        href={getPath(`/categories/${encodeURIComponent(cat)}/`)}
        class="px-3 py-1 rounded text-xs font-mono font-medium bg-[var(--bg-card)] hover:bg-[var(--border-subtle)] text-[var(--text-body)] hover:text-[var(--text-headline)] border border-[var(--border-subtle)] transition-colors shrink-0"
        data-category={cat}
      >
        {cat}
      </a>
    ))}
  </section>

  <!-- Chronological News Wire Feed -->
  <section class="divide-y divide-[var(--border-subtle)]">
    <div class="flex items-center justify-between pb-3">
      <h2 class="text-xl font-bold font-newspaper text-[var(--text-headline)] tracking-wide flex items-center gap-2">
        <span class="text-[var(--accent-editorial)]">⚡</span> <span data-i18n="wireStreamTitle">Continuous Wire Stream</span>
      </h2>
      <span class="text-xs font-mono text-[var(--text-muted)]">
        {wireArticles.length} <span data-i18n="storiesIndexed">Stories Indexed</span>
      </span>
    </div>

    <div class="space-y-1">
      {wireArticles.map((article) => (
        <NewsListItem
          title={article.data.title}
          description={article.data.description}
          slug={article.id.replace(/\.md$/, '')}
          pubDate={article.data.pubDate}
          category={article.data.category}
          sourceName={article.data.sourceName}
          sourceUrl={article.data.sourceUrl}
          keyTakeaways={article.data.keyTakeaways}
          isWeeklyDigest={article.data.isWeeklyDigest}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<script define:vars={{ newsTranslations }}>
  function updateHomepageNews(lang) {
    if (!lang) return;

    document.querySelectorAll('[data-news-id]').forEach((el) => {
      const id = el.getAttribute('data-news-id');
      if (!id || !newsTranslations[id]) return;

      const data = (lang !== 'en' && newsTranslations[id][lang])
        ? newsTranslations[id][lang]
        : newsTranslations[id].en;

      if (!data) return;

      const titleEl = el.querySelector('[data-news-title]');
      const descEl = el.querySelector('[data-news-desc]');
      const takeawayEl = el.querySelector('[data-news-takeaway]');

      if (titleEl && data.title) {
        titleEl.textContent = data.title;
      }
      if (descEl && data.description) {
        descEl.textContent = data.description;
      }
      if (takeawayEl && data.keyTakeaways && data.keyTakeaways[0]) {
        takeawayEl.textContent = data.keyTakeaways[0];
      }
    });
  }

  // Listen for language change events dispatched from header
  window.addEventListener('pageLanguageChanged', (e) => {
    if (e.detail && e.detail.lang) {
      updateHomepageNews(e.detail.lang);
    }
  });

  // Run on load if saved language is not English
  document.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem('site_lang') || 'en';
    if (saved && saved !== 'en') {
      updateHomepageNews(saved);
    }
  });
</script>
