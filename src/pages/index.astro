---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadStory from '../components/LeadStory.astro';
import NewsCard from '../components/NewsCard.astro';

const allNews = await getCollection('news');

// Sort by date descending
const sortedNews = allNews.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const digests = sortedNews.filter((item) => item.data.isWeeklyDigest);
const regularArticles = sortedNews.filter((item) => !item.data.isWeeklyDigest);

const leadStory = regularArticles[0];
const gridArticles = regularArticles.slice(1);

const categories = Array.from(new Set(allNews.map((item) => item.data.category)));
---

<BaseLayout>
  <!-- Newsroom Status & Ticker -->
  <section class="mb-8 p-4 rounded-xl bg-[#0e1626] border border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span class="text-slate-400">Pipeline Status:</span>
        <span class="text-emerald-400 font-semibold">Autonomous Active</span>
      </div>
      <div class="hidden sm:flex items-center gap-2">
        <span class="text-slate-400">Intelligence Engine:</span>
        <span class="text-slate-200">Gemini Flash (2.0)</span>
      </div>
      <div class="hidden md:flex items-center gap-2">
        <span class="text-slate-400">Cadence:</span>
        <span class="text-slate-200">Daily Updates + Weekly Digests</span>
      </div>
    </div>
    <div class="text-slate-400">
      Total Dispatches: <strong class="text-cyan-400">{allNews.length}</strong>
    </div>
  </section>

  <!-- Lead Story -->
  {leadStory && (
    <LeadStory
      title={leadStory.data.title}
      description={leadStory.data.description}
      slug={leadStory.id.replace(/\.md$/, '')}
      pubDate={leadStory.data.pubDate}
      category={leadStory.data.category}
      sourceName={leadStory.data.sourceName}
      keyTakeaways={leadStory.data.keyTakeaways}
    />
  )}

  <!-- Weekly Digest Spotlight (if any digest exists) -->
  {digests.length > 0 && (
    <section class="mb-12 p-6 rounded-xl bg-gradient-to-r from-amber-950/20 via-[#131b2e] to-[#0e1626] border border-amber-500/30">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center gap-2 font-mono text-sm font-bold text-amber-400 uppercase tracking-wider">
          <span class="text-lg">📋</span>
          Latest Executive AI Briefing
        </div>
        <a href="/digests" class="text-xs font-mono text-amber-400 hover:text-amber-300 flex items-center gap-1 font-semibold">
          View All Weekly Briefings →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {digests.slice(0, 2).map((digest) => (
          <a
            href={`/news/${digest.id.replace(/\.md$/, '')}`}
            class="p-4 rounded-lg bg-[#090d16]/80 border border-amber-500/20 hover:border-amber-400/50 hover:bg-[#0c1424] transition-all block group"
          >
            <div class="text-xs font-mono text-amber-400 mb-1">
              {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(digest.data.pubDate)}
            </div>
            <h4 class="text-base font-bold text-white group-hover:text-amber-300 transition-colors line-clamp-2">
              {digest.data.title}
            </h4>
            <p class="text-xs text-slate-300 line-clamp-2 mt-2">
              {digest.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Category Filter Pill Bar -->
  <section class="mb-8 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
    <span class="text-xs font-mono uppercase text-slate-400 font-semibold mr-1 shrink-0">Filter:</span>
    <a
      href="/"
      class="px-3 py-1 rounded-full text-xs font-mono font-medium bg-cyan-500 text-slate-950 hover:bg-cyan-400 transition-colors shrink-0"
    >
      All Feed
    </a>
    {categories.map((cat) => (
      <a
        href={`/categories/${encodeURIComponent(cat)}`}
        class="px-3 py-1 rounded-full text-xs font-mono font-medium bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700/60 transition-colors shrink-0"
      >
        {cat}
      </a>
    ))}
  </section>

  <!-- News Grid -->
  <section>
    <div class="flex items-center justify-between mb-6 pb-2 border-b border-slate-800">
      <h2 class="text-xl font-bold font-mono text-white tracking-wide uppercase flex items-center gap-2">
        <span class="text-cyan-400">⚡</span> Frontier Dispatches
      </h2>
      <span class="text-xs font-mono text-slate-400">
        Showing {gridArticles.length + (leadStory ? 1 : 0)} Reports
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {gridArticles.map((article) => (
        <NewsCard
          title={article.data.title}
          description={article.data.description}
          slug={article.id.replace(/\.md$/, '')}
          pubDate={article.data.pubDate}
          category={article.data.category}
          tags={article.data.tags}
          sourceName={article.data.sourceName}
          sourceUrl={article.data.sourceUrl}
          keyTakeaways={article.data.keyTakeaways}
          isWeeklyDigest={article.data.isWeeklyDigest}
        />
      ))}
    </div>
  </section>
</BaseLayout>
