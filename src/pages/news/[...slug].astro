---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPath } from '../../utils/url';

export async function getStaticPaths() {
  const newsEntries = (await getCollection('news')).filter((entry) => entry.data.sourcePolicy === 'primary');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allNews = (await getCollection('news')).filter((item) => item.data.sourcePolicy === 'primary');
const relatedArticles = allNews
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.pubDate);

// Word count & reading time estimate
const wordCount = (entry.body || '').split(/\s+/).length + entry.data.description.split(/\s+/).length;
const readingTimeMin = Math.max(1, Math.ceil(wordCount / 200));

const articleTitle = `${entry.data.title} | Neural Pulse`;

const languages = [
  { code: 'en', flag: '🇬🇧', name: 'English' },
  { code: 'tr', flag: '🇹🇷', name: 'Türkçe' },
  { code: 'es', flag: '🇪🇸', name: 'Español' },
  { code: 'zh', flag: '🇨🇳', name: '中文' },
  { code: 'it', flag: '🇮🇹', name: 'Italiano' },
  { code: 'de', flag: '🇩🇪', name: 'Deutsch' },
];

const articleTranslations = entry.data.translations || {};
const defaultData = {
  title: entry.data.title,
  description: entry.data.description,
  keyTakeaways: entry.data.keyTakeaways || [],
};
---

<BaseLayout title={articleTitle} description={entry.data.description} articleDate={entry.data.pubDate.toISOString()}>
  <!-- NewsArticle JSON-LD Structured Data for Google News & Search -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": entry.data.title,
    "description": entry.data.description,
    "datePublished": entry.data.pubDate.toISOString(),
    "author": [{
      "@type": "Organization",
      "name": "Neural Pulse AI",
      "url": "https://emirfs.github.io/ai-news-hub/"
    }],
    "publisher": {
      "@type": "NewsMediaOrganization",
      "name": "Neural Pulse",
      "url": "https://emirfs.github.io/ai-news-hub/"
    },
    "mainEntityOfPage": Astro.url.href
  })} />

  <!-- Reading Progress Bar -->
  <div id="reading-progress-bar" class="fixed top-0 left-0 h-1 bg-[var(--accent-editorial)] z-50 transition-all duration-75 w-0"></div>

  <article class="reading-column py-6">
    <nav class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)] mb-6 border-b border-[var(--border-subtle)] pb-3">
      <a href={getPath('/')} class="hover:text-[var(--accent-editorial)] transition-colors inline-flex items-center gap-1.5 font-medium">
        <span>←</span>
        <span id="ui-back-link">Back to Dispatches</span>
      </a>
      <a href={getPath(`/categories/${encodeURIComponent(entry.data.category)}/`)} class="text-[var(--text-muted)] hover:text-[var(--text-headline)] transition-colors">
        {entry.data.category}
      </a>
    </nav>

    {Object.keys(articleTranslations).length > 0 && <div class="mb-8 p-3.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono shadow-xs">
      <div class="flex items-center gap-2 text-[var(--text-muted)]">
        <span class="text-base">🌐</span>
        <span class="font-bold text-[var(--text-headline)]" id="ui-lang-label">Select Reading Language:</span>
      </div>
      <div class="flex flex-wrap items-center gap-1.5">
        {languages.filter((l) => l.code === 'en' || articleTranslations[l.code]).map((l) => (
          <button
            type="button"
            data-lang-code={l.code}
            class={`article-lang-btn px-2.5 py-1 rounded border transition-colors cursor-pointer flex items-center gap-1.5 text-xs font-semibold ${
              l.code === 'en'
                ? 'bg-[var(--accent-editorial)] text-white border-[var(--accent-editorial)] active-lang'
                : 'border-[var(--border-subtle)] bg-[var(--bg-card)] text-[var(--text-headline)] hover:border-[var(--accent-editorial)]'
            }`}
          >
            <span>{l.flag}</span>
            <span>{l.name}</span>
          </button>
        ))}
      </div>
    </div>}

    <!-- Article Header -->
    <header class="mb-8 space-y-4">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
        <span class="px-2.5 py-0.5 rounded border border-[var(--border-strong)] bg-[var(--badge-bg)] text-[var(--badge-text)] text-[11px] font-bold uppercase tracking-wider">
          {entry.data.category}
        </span>
        <time datetime={entry.data.pubDate.toISOString()} class="text-[var(--text-muted)]">
          {formattedDate}
        </time>
        <span class="text-[var(--border-strong)]">•</span>
        <span class="text-[var(--text-muted)]" id="ui-reading-time">
          {readingTimeMin} min read
        </span>
      </div>

      <!-- Main Headline -->
      <h1 id="article-title" class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold text-[var(--text-headline)] tracking-tight leading-[1.18] font-newspaper">
        {entry.data.title}
      </h1>

      <!-- Lead Excerpt -->
      <p id="article-desc" class="text-lg sm:text-xl text-[var(--text-body)] leading-relaxed font-sans pt-1">
        {entry.data.description}
      </p>

      <!-- Byline -->
      <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[var(--text-muted)]">
        <div>
          <span id="ui-byline-label">Source-attributed; not independently verified. Reporter:</span>
          <strong class="text-[var(--text-headline)]">{entry.data.author}</strong>
        </div>
        <div>
          Neural Pulse Desk
        </div>
        <div class="flex items-center gap-2">
          <!-- Share Actions -->
          <button
            id="copy-link-btn"
            type="button"
            class="px-2 py-0.5 rounded border border-[var(--border-subtle)] hover:border-[var(--accent-editorial)] hover:text-[var(--accent-editorial)] transition-colors cursor-pointer"
            title="Copy article link"
          >
            🔗 Copy Link
          </button>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(Astro.url.href)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2 py-0.5 rounded border border-[var(--border-subtle)] hover:border-[var(--accent-editorial)] hover:text-[var(--accent-editorial)] transition-colors"
            title="Share on X"
          >
            𝕏 Share
          </a>
        </div>
      </div>
    </header>

    <!-- PROMINENT ORIGINAL SOURCE REDIRECTION CARD (TOP) -->
    {entry.data.sourceUrl && (
      <aside class="my-8 p-4 sm:p-5 rounded-lg bg-[var(--bg-surface)] border-2 border-[var(--accent-editorial)] shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent-editorial)]">
            <span>📰</span> <span id="ui-source-badge">Reported source</span>
          </div>
          <p class="text-xs sm:text-sm text-[var(--text-body)]">
            Source attribution: <strong class="text-[var(--text-headline)]">{entry.data.sourceName || 'Original source'}</strong>. This citation does not indicate independent verification.
          </p>
        </div>
        <a
          href={entry.data.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded bg-[var(--accent-editorial)] text-white font-mono text-xs font-bold hover:opacity-90 transition-opacity shrink-0 shadow-xs"
        >
          <span id="ui-open-source-btn">Open Original Source</span>
          <span class="text-sm">↗</span>
        </a>
      </aside>
    )}

    <!-- Key Takeaways Callout Box -->
    {entry.data.keyTakeaways && entry.data.keyTakeaways.length > 0 && (
      <section class="my-10 p-6 rounded-r-lg bg-[var(--bg-card)] border-l-4 border-[var(--accent-editorial)] border-y border-r border-[var(--border-subtle)]">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider mb-3.5">
          <span>⚡</span> <span id="ui-takeaways-heading">Executive Summary & Core Signals</span>
        </div>
        <ul id="takeaways-list" class="space-y-3 text-base text-[var(--text-body)]">
          {entry.data.keyTakeaways.map((point: string) => (
            <li class="flex items-start gap-3 leading-relaxed">
              <span class="text-[var(--accent-editorial)] font-bold mt-1 text-sm">▸</span>
              <span class="takeaway-text">{point}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Main Markdown Body (Deep Analysis) -->
    <div class="article-prose mt-10">
      <Content />
    </div>

    <!-- PROMINENT ORIGINAL SOURCE REDIRECTION (BOTTOM) -->
    {entry.data.sourceUrl && (
      <section class="mt-14 p-6 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-strong)] text-center space-y-3 shadow-xs">
        <h4 class="text-lg font-bold font-newspaper text-[var(--text-headline)]" id="ui-bottom-prompt">
          Read the cited source
        </h4>
        <p class="text-xs sm:text-sm text-[var(--text-muted)] max-w-lg mx-auto">
          This article summarizes its cited source. Its claims have not been independently verified.
        </p>
        <div class="pt-2">
          <a
            href={entry.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded bg-[var(--text-headline)] text-[var(--bg-primary)] font-mono text-xs font-bold hover:opacity-90 transition-opacity"
          >
            <span>Visit {entry.data.sourceName || 'Primary Document'} ↗</span>
          </a>
        </div>
      </section>
    )}

    <!-- Tags -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <footer class="mt-12 pt-6 border-t border-[var(--border-subtle)] flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-[var(--text-muted)] mr-2">Filed under:</span>
        {entry.data.tags.map((tag: string) => (
          <span class="px-2.5 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs font-mono text-[var(--text-muted)]">
            #{tag}
          </span>
        ))}
      </footer>
    )}

    <!-- Continue Reading -->
    {relatedArticles.length > 0 && (
      <section class="mt-16 pt-10 border-t border-[var(--border-subtle)]">
        <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-6 flex items-center gap-2">
          <span>◆</span> Continue Reading Frontier News
        </h3>
        <div class="space-y-4">
          {relatedArticles.map((item) => (
            <a
              href={getPath(`/news/${item.id.replace(/\.md$/, '')}/`)}
              class="p-4 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--border-strong)] transition-colors block group"
            >
              <div class="text-xs font-mono text-[var(--text-muted)] mb-1">
                {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(item.data.pubDate)} • {item.data.category}
              </div>
              <h4 class="text-base font-bold text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors font-newspaper">
                {item.data.title}
              </h4>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script define:vars={{ articleTranslations, defaultData }}>
  const UI_TEXT = {
    en: {
      backLink: 'Back to Dispatches',
      langLabel: 'Select Reading Language:',
      takeawaysHeading: 'Reported summary and takeaways',
      sourceBadge: 'Reported source',
      openSourceBtn: 'Open cited source',
      bottomPrompt: 'Read the cited source'
    },
    tr: {
      backLink: 'Haber Akışına Dön',
      langLabel: 'Okuma Dilini Seçin:',
      readingTimeSuffix: 'dakika detaylı okuma',
      takeawaysHeading: 'Yönetici Özeti ve Temel Sinyaller',
      sourceBadge: 'Atıf yapılan kaynak',
      openSourceBtn: 'Atıf yapılan kaynağı aç',
      bottomPrompt: 'Atıf yapılan kaynağı inceleyin'
    },
    es: {
      backLink: 'Volver a los Despachos',
      langLabel: 'Seleccionar Idioma de Lectura:',
      readingTimeSuffix: 'minutos de lectura profunda',
      takeawaysHeading: 'Resumen y puntos destacados atribuidos',
      sourceBadge: 'Fuente citada',
      openSourceBtn: 'Abrir fuente citada',
      bottomPrompt: 'Leer la fuente citada'
    },
    zh: {
      backLink: '返回快讯列表',
      langLabel: '选择阅读语言：',
      readingTimeSuffix: '分钟深度阅读',
      takeawaysHeading: '核心要点与技术摘要',
      sourceBadge: '引用来源',
      openSourceBtn: '打开引用来源',
      bottomPrompt: '阅读引用来源'
    },
    it: {
      backLink: 'Torna alle Notizie',
      langLabel: 'Seleziona Lingua di Lettura:',
      readingTimeSuffix: 'minuti di lettura approfondita',
      takeawaysHeading: 'Riepilogo e punti attribuiti',
      sourceBadge: 'Fonte citata',
      openSourceBtn: 'Apri la fonte citata',
      bottomPrompt: 'Leggi la fonte citata'
    },
    de: {
      backLink: 'Zurück zur Übersicht',
      langLabel: 'Lesesprache Auswählen:',
      readingTimeSuffix: 'Minuten Tiefenanalyse',
      takeawaysHeading: 'Zugeordnete Zusammenfassung und Hinweise',
      sourceBadge: 'Zitierte Quelle',
      openSourceBtn: 'Zitierte Quelle öffnen',
      bottomPrompt: 'Zitierte Quelle lesen'
    }
  };

  const SECTION_TITLES = {
    tr: {
      'Executive Overview & Strategic Significance': 'Yönetici Özeti ve Stratejik Önem',
      'Architectural Breakdown & How It Operates': 'Mimari ve Çalışma Mekanizması',
      'Key Benchmarks, Metrics & Performance Data': 'Performans Testleri ve Benchmark Verileri',
      'Practical Developer & Industry Applications': 'Geliştirici ve Sektörel Uygulama Senaryoları',
      'Ecosystem Outlook & Limitations': 'Ekosistem Görünümü ve Mevcut Sınırlar'
    },
    es: {
      'Executive Overview & Strategic Significance': 'Resumen Ejecutivo y Significado Estratégico',
      'Architectural Breakdown & How It Operates': 'Desglose Arquitectónico y Funcionamiento',
      'Key Benchmarks, Metrics & Performance Data': 'Puntos de Referencia y Datos de Rendimiento',
      'Practical Developer & Industry Applications': 'Aplicaciones Prácticas para Desarrolladores',
      'Ecosystem Outlook & Limitations': 'Perspectiva del Ecosistema y Limitaciones'
    },
    zh: {
      'Executive Overview & Strategic Significance': '执行概述与战略意义',
      'Architectural Breakdown & How It Operates': '架构解析与运行机制',
      'Key Benchmarks, Metrics & Performance Data': '关键基准评测与性能数据',
      'Practical Developer & Industry Applications': '开发者实战与行业落地应用',
      'Ecosystem Outlook & Limitations': '生态展望与现阶段局限性'
    },
    it: {
      'Executive Overview & Strategic Significance': 'Panoramica Esecutiva e Significato Strategico',
      'Architectural Breakdown & How It Operates': 'Analisi Architetturale e Funzionamento',
      'Key Benchmarks, Metrics & Performance Data': 'Benchmark Chiave e Dati sulle Prestazioni',
      'Practical Developer & Industry Applications': 'Applicazioni Pratiche per Sviluppatori',
      'Ecosystem Outlook & Limitations': 'Prospettive dell\'Ecosistema e Limitazioni'
    },
    de: {
      'Executive Overview & Strategic Significance': 'Zusammenfassung & Strategische Bedeutung',
      'Architectural Breakdown & How It Operates': 'Architekturübersicht & Funktionsweise',
      'Key Benchmarks, Metrics & Performance Data': 'Wichtige Benchmarks & Leistungsdaten',
      'Practical Developer & Industry Applications': 'Praktische Entwickler- & Industrieanwendungen',
      'Ecosystem Outlook & Limitations': 'Ökosystem-Ausblick & Grenzen'
    }
  };

  function applyLanguage(lang) {
    // 1. Update active button style
    document.querySelectorAll('.article-lang-btn').forEach(btn => {
      const isSelected = btn.getAttribute('data-lang-code') === lang;
      if (isSelected) {
        btn.classList.add('bg-[var(--accent-editorial)]', 'text-white', 'border-[var(--accent-editorial)]');
        btn.classList.remove('bg-[var(--bg-card)]', 'text-[var(--text-headline)]');
      } else {
        btn.classList.remove('bg-[var(--accent-editorial)]', 'text-white', 'border-[var(--accent-editorial)]');
        btn.classList.add('bg-[var(--bg-card)]', 'text-[var(--text-headline)]');
      }
    });

    // 2. Update Article Title & Description
    const titleEl = document.getElementById('article-title');
    const descEl = document.getElementById('article-desc');
    const takeawaysUl = document.getElementById('takeaways-list');

    let currentTitle = defaultData.title;
    let currentDesc = defaultData.description;
    let currentTakeaways = defaultData.keyTakeaways;

    if (lang !== 'en' && articleTranslations[lang]) {
      currentTitle = articleTranslations[lang].title || defaultData.title;
      currentDesc = articleTranslations[lang].description || defaultData.description;
      currentTakeaways = articleTranslations[lang].keyTakeaways || defaultData.keyTakeaways;
    }

    if (titleEl) titleEl.textContent = currentTitle;
    if (descEl) descEl.textContent = currentDesc;

    if (takeawaysUl && currentTakeaways.length > 0) {
      const items = takeawaysUl.querySelectorAll('.takeaway-text');
      items.forEach((item, idx) => {
        if (currentTakeaways[idx]) {
          item.textContent = currentTakeaways[idx];
        }
      });
    }

    // 3. Update UI Labels
    const ui = UI_TEXT[lang] || UI_TEXT.en;
    const backLink = document.getElementById('ui-back-link');
    const langLabel = document.getElementById('ui-lang-label');
    const takeawaysHeading = document.getElementById('ui-takeaways-heading');
    const sourceBadge = document.getElementById('ui-source-badge');
    const openSourceBtn = document.getElementById('ui-open-source-btn');
    const bottomPrompt = document.getElementById('ui-bottom-prompt');

    if (backLink) backLink.textContent = ui.backLink;
    if (langLabel) langLabel.textContent = ui.langLabel;
    if (takeawaysHeading) takeawaysHeading.textContent = ui.takeawaysHeading;
    if (sourceBadge) sourceBadge.textContent = ui.sourceBadge;
    if (openSourceBtn) openSourceBtn.textContent = ui.openSourceBtn;
    if (bottomPrompt) bottomPrompt.textContent = ui.bottomPrompt;

    // 4. Update FULL Article Body (all paragraphs, sections, lists)
    const proseEl = document.querySelector('.article-prose');
    if (proseEl) {
      if (!proseEl.hasAttribute('data-orig-html')) {
        proseEl.setAttribute('data-orig-html', proseEl.innerHTML);
      }
      if (lang === 'en') {
        proseEl.innerHTML = proseEl.getAttribute('data-orig-html');
      } else if (articleTranslations[lang] && articleTranslations[lang].body_html) {
        proseEl.innerHTML = articleTranslations[lang].body_html;
      }
    }

    localStorage.setItem('site_lang', lang);
  }

  // Also listen for language change events dispatched from header
  window.addEventListener('pageLanguageChanged', (e) => {
    if (e.detail && e.detail.lang) {
      applyLanguage(e.detail.lang);
    }
  });

  // Hook up button clicks
  document.querySelectorAll('.article-lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang-code');
      applyLanguage(lang);
    });
  });

  // Restore saved language if set
  const savedLang = localStorage.getItem('site_lang');
  if (savedLang && ['en', 'tr', 'es', 'zh', 'it', 'de'].includes(savedLang)) {
    applyLanguage(savedLang);
  }

  // Reading Progress Bar
  const progressBar = document.getElementById('reading-progress-bar');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    });
  }

  // Copy Link Button
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtn.textContent;
        copyBtn.textContent = '✓ Copied!';
        setTimeout(() => { copyBtn.textContent = originalText; }, 2000);
      } catch (err) {
        console.error('Failed to copy link', err);
      }
    });
  }
</script>
