---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPath } from '../../utils/url';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allNews = await getCollection('news');
const relatedArticles = allNews
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.pubDate);

// Word count & reading time estimate
const wordCount = (entry.body || '').split(/\s+/).length + entry.data.description.split(/\s+/).length;
const readingTimeMin = Math.max(2, Math.ceil(wordCount / 170));

const articleTitle = `${entry.data.title} | Neural Pulse`;

const languages = [
  { code: 'en', flag: '🇬🇧', name: 'English' },
  { code: 'tr', flag: '🇹🇷', name: 'Türkçe' },
  { code: 'es', flag: '🇪🇸', name: 'Español' },
  { code: 'zh-CN', flag: '🇨🇳', name: '中文' },
  { code: 'it', flag: '🇮🇹', name: 'Italiano' },
  { code: 'de', flag: '🇩🇪', name: 'Deutsch' },
];
---

<BaseLayout title={articleTitle} description={entry.data.description} articleDate={entry.data.pubDate.toISOString()}>
  <article class="reading-column py-6">
    <!-- Breadcrumb & Back Link -->
    <nav class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)] mb-6 border-b border-[var(--border-subtle)] pb-3">
      <a href={getPath('/')} class="hover:text-[var(--accent-editorial)] transition-colors inline-flex items-center gap-1.5 font-medium">
        <span>←</span>
        <span>Back to Dispatches</span>
      </a>
      <a href={getPath(`/categories/${encodeURIComponent(entry.data.category)}/`)} class="text-[var(--text-muted)] hover:text-[var(--text-headline)] transition-colors">
        {entry.data.category}
      </a>
    </nav>

    <!-- Multi-Language Reader Bar -->
    <div class="mb-8 p-3 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
      <span class="text-[var(--text-muted)] flex items-center gap-1.5 font-semibold">
        <span>🌐</span> Read in your language:
      </span>
      <div class="flex flex-wrap items-center gap-1.5">
        {languages.map((l) => (
          <button
            type="button"
            data-lang-code={l.code}
            class="article-lang-btn px-2.5 py-1 rounded border border-[var(--border-subtle)] bg-[var(--bg-card)] hover:border-[var(--accent-editorial)] hover:text-[var(--accent-editorial)] text-[var(--text-headline)] transition-colors cursor-pointer flex items-center gap-1 text-[11px]"
          >
            <span>{l.flag}</span>
            <span>{l.name}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Article Header -->
    <header class="mb-8 space-y-4">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
        <span class="px-2.5 py-0.5 rounded border border-[var(--border-strong)] bg-[var(--badge-bg)] text-[var(--badge-text)] text-[11px] font-bold uppercase tracking-wider">
          {entry.data.category}
        </span>
        <time datetime={entry.data.pubDate.toISOString()} class="text-[var(--text-muted)]">
          {formattedDate}
        </time>
        <span class="text-[var(--border-strong)]">•</span>
        <span class="text-[var(--text-muted)]">
          {readingTimeMin} min in-depth read
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] font-bold text-[var(--text-headline)] tracking-tight leading-[1.18] font-newspaper">
        {entry.data.title}
      </h1>

      <!-- Lead Excerpt -->
      <p class="text-lg sm:text-xl text-[var(--text-body)] leading-relaxed font-sans pt-1">
        {entry.data.description}
      </p>

      <!-- Byline -->
      <div class="pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-[var(--text-muted)]">
        <div>
          Curated & Verified by <span class="text-[var(--text-headline)] font-medium">{entry.data.author}</span>
        </div>
        <div>
          Autonomous AI Newsroom
        </div>
      </div>
    </header>

    <!-- PROMINENT ORIGINAL SOURCE REDIRECTION CARD (TOP) -->
    {entry.data.sourceUrl && (
      <aside class="my-8 p-4 sm:p-5 rounded-lg bg-[var(--bg-surface)] border border-[var(--accent-editorial)] shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2 text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--accent-editorial)]">
            <span>📰</span> Primary Source Document
          </div>
          <p class="text-xs sm:text-sm text-[var(--text-body)]">
            Original publication on <strong class="text-[var(--text-headline)]">{entry.data.sourceName || 'Primary Wire'}</strong>
          </p>
        </div>
        <a
          href={entry.data.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded bg-[var(--accent-editorial)] text-white font-mono text-xs font-bold hover:opacity-90 transition-opacity shrink-0 shadow-xs"
        >
          <span>Open Original Source</span>
          <span class="text-sm">↗</span>
        </a>
      </aside>
    )}

    <!-- Key Takeaways Callout Box -->
    {entry.data.keyTakeaways && entry.data.keyTakeaways.length > 0 && (
      <section class="my-10 p-6 rounded-r-lg bg-[var(--bg-card)] border-l-4 border-[var(--accent-editorial)] border-y border-r border-[var(--border-subtle)]">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider mb-3.5">
          <span>⚡</span> Executive Summary & Core Signals
        </div>
        <ul class="space-y-3 text-base text-[var(--text-body)]">
          {entry.data.keyTakeaways.map((point: string) => (
            <li class="flex items-start gap-3 leading-relaxed">
              <span class="text-[var(--accent-editorial)] font-bold mt-1 text-sm">▸</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Main Markdown Body (Deep Analysis) -->
    <div class="article-prose mt-10">
      <Content />
    </div>

    <!-- PROMINENT ORIGINAL SOURCE REDIRECTION (BOTTOM) -->
    {entry.data.sourceUrl && (
      <section class="mt-12 p-6 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-strong)] text-center space-y-3">
        <h4 class="text-base font-bold font-newspaper text-[var(--text-headline)]">
          Want to verify the primary technical research?
        </h4>
        <p class="text-xs sm:text-sm text-[var(--text-muted)] max-w-lg mx-auto">
          Neural Pulse provides objective summaries and architectural analysis. Read the full paper or release notes on the primary platform:
        </p>
        <div class="pt-2">
          <a
            href={entry.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded border border-[var(--accent-editorial)] text-[var(--accent-editorial)] hover:bg-[var(--accent-editorial)] hover:text-white font-mono text-xs font-bold transition-all"
          >
            <span>Visit {entry.data.sourceName || 'Primary Document'} ↗</span>
          </a>
        </div>
      </section>
    )}

    <!-- Tags -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <footer class="mt-12 pt-6 border-t border-[var(--border-subtle)] flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-[var(--text-muted)] mr-2">Filed under:</span>
        {entry.data.tags.map((tag: string) => (
          <span class="px-2.5 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-subtle)] text-xs font-mono text-[var(--text-muted)]">
            #{tag}
          </span>
        ))}
      </footer>
    )}

    <!-- Continue Reading -->
    {relatedArticles.length > 0 && (
      <section class="mt-16 pt-10 border-t border-[var(--border-subtle)]">
        <h3 class="text-sm font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-6 flex items-center gap-2">
          <span>◆</span> Continue Reading Frontier News
        </h3>
        <div class="space-y-4">
          {relatedArticles.map((item) => (
            <a
              href={getPath(`/news/${item.id.replace(/\.md$/, '')}/`)}
              class="p-4 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--border-strong)] transition-colors block group"
            >
              <div class="text-xs font-mono text-[var(--text-muted)] mb-1">
                {new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(item.data.pubDate)} • {item.data.category}
              </div>
              <h4 class="text-base font-bold text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors font-newspaper">
                {item.data.title}
              </h4>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<script is:inline>
  // Article Page Instant Language Switcher
  document.querySelectorAll('.article-lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const langCode = btn.getAttribute('data-lang-code');
      localStorage.setItem('site_lang', langCode);

      const combo = document.querySelector('.goog-te-combo');
      if (combo) {
        combo.value = langCode === 'en' ? '' : langCode;
        combo.dispatchEvent(new Event('change'));
      }

      // Update flag in header if available
      const flagSpan = document.getElementById('current-lang-flag');
      const labelSpan = document.getElementById('current-lang-label');
      if (flagSpan && labelSpan) {
        labelSpan.textContent = langCode.toUpperCase().slice(0, 2);
      }
    });
  });
</script>
