---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.pubDate);

const articleTitle = `${entry.data.title} | Neural Pulse`;
---

<BaseLayout title={articleTitle} description={entry.data.description} articleDate={entry.data.pubDate.toISOString()}>
  <article class="max-w-4xl mx-auto py-4">
    <!-- Breadcrumb & Back -->
    <nav class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-6">
      <a href="/" class="hover:text-cyan-400 transition-colors">← Back to Newsroom</a>
      <span>/</span>
      <a href={`/categories/${encodeURIComponent(entry.data.category)}`} class="text-cyan-400 hover:underline">
        {entry.data.category}
      </a>
    </nav>

    <!-- Header info -->
    <header class="mb-8 border-b border-slate-800 pb-8 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-xs font-mono font-bold uppercase">
          {entry.data.category}
        </span>
        <time datetime={entry.data.pubDate.toISOString()} class="text-xs font-mono text-slate-400">
          {formattedDate}
        </time>
        <span class="text-slate-600">•</span>
        <span class="text-xs font-mono text-slate-400">
          Curated by: <span class="text-slate-200">{entry.data.author}</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-300 leading-relaxed">
        {entry.data.description}
      </p>

      <!-- Source Attribution Badge -->
      {entry.data.sourceUrl && (
        <div class="pt-2 flex items-center gap-2 text-xs font-mono">
          <span class="text-slate-400">Original Primary Source:</span>
          <a
            href={entry.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-slate-800/80 hover:bg-slate-700 text-cyan-400 hover:text-cyan-300 border border-slate-700 transition-colors"
          >
            <span>{entry.data.sourceName || 'Primary Document'}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      )}
    </header>

    <!-- Key Takeaways Callout Box -->
    {entry.data.keyTakeaways && entry.data.keyTakeaways.length > 0 && (
      <section class="my-8 p-6 rounded-xl bg-gradient-to-r from-cyan-950/30 via-[#0f172a] to-[#0c121e] border border-cyan-500/30 shadow-lg">
        <div class="flex items-center gap-2 text-sm font-mono font-bold text-cyan-400 uppercase tracking-wider mb-3">
          <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          AI Executive Summary & Key Takeaways
        </div>
        <ul class="space-y-2.5 text-sm sm:text-base text-slate-200">
          {entry.data.keyTakeaways.map((point: string) => (
            <li class="flex items-start gap-2.5">
              <span class="text-cyan-400 font-bold mt-1">▸</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Main Markdown Body -->
    <div class="article-prose mt-8">
      <Content />
    </div>

    <!-- Tags & Footer Info -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <footer class="mt-12 pt-6 border-t border-slate-800 flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-slate-400 mr-2">Filed under:</span>
        {entry.data.tags.map((tag: string) => (
          <span class="px-2.5 py-1 rounded bg-slate-800/80 border border-slate-700/60 text-xs font-mono text-slate-300">
            #{tag}
          </span>
        ))}
      </footer>
    )}
  </article>
</BaseLayout>
