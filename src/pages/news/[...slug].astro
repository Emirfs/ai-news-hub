---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.pubDate);

const articleTitle = `${entry.data.title} | Neural Pulse`;
---

<BaseLayout title={articleTitle} description={entry.data.description} articleDate={entry.data.pubDate.toISOString()}>
  <article class="max-w-3xl mx-auto py-6">
    <!-- Breadcrumb & Back -->
    <nav class="flex items-center gap-2 text-xs font-mono text-neutral-400 mb-6 border-b border-neutral-800 pb-3">
      <a href="/" class="hover:text-amber-400 transition-colors">← Back to Newsroom</a>
      <span>/</span>
      <a href={`/categories/${encodeURIComponent(entry.data.category)}`} class="text-neutral-300 hover:text-white transition-colors">
        {entry.data.category}
      </a>
    </nav>

    <!-- Header info -->
    <header class="mb-8 border-b border-neutral-800 pb-8 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-2.5 py-0.5 rounded bg-neutral-800 text-neutral-200 border border-neutral-700 text-xs font-mono font-bold uppercase">
          {entry.data.category}
        </span>
        <time datetime={entry.data.pubDate.toISOString()} class="text-xs font-mono text-neutral-400">
          {formattedDate}
        </time>
        <span class="text-neutral-600">•</span>
        <span class="text-xs font-mono text-neutral-400">
          Curator: <span class="text-neutral-200">{entry.data.author}</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight font-newspaper">
        {entry.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-neutral-300 leading-relaxed font-sans">
        {entry.data.description}
      </p>

      <!-- Source Attribution Badge -->
      {entry.data.sourceUrl && (
        <div class="pt-2 flex items-center gap-2 text-xs font-mono">
          <span class="text-neutral-400">Primary Technical Source:</span>
          <a
            href={entry.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-neutral-900 hover:bg-neutral-800 text-amber-400 hover:text-amber-300 border border-neutral-700 transition-colors"
          >
            <span>{entry.data.sourceName || 'Primary Document'}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      )}
    </header>

    <!-- Key Takeaways Callout Box -->
    {entry.data.keyTakeaways && entry.data.keyTakeaways.length > 0 && (
      <section class="my-8 p-6 rounded bg-[#141416] border border-neutral-800 shadow-sm">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-amber-400 uppercase tracking-wider mb-3">
          <span>⚡</span> Key Editorial Insights
        </div>
        <ul class="space-y-2.5 text-sm sm:text-base text-neutral-200">
          {entry.data.keyTakeaways.map((point: string) => (
            <li class="flex items-start gap-2.5">
              <span class="text-amber-400 font-bold mt-1">▸</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Main Markdown Body -->
    <div class="article-prose mt-8">
      <Content />
    </div>

    <!-- Tags & Footer Info -->
    {entry.data.tags && entry.data.tags.length > 0 && (
      <footer class="mt-12 pt-6 border-t border-neutral-800 flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-neutral-400 mr-2">Topics:</span>
        {entry.data.tags.map((tag: string) => (
          <span class="px-2.5 py-1 rounded bg-neutral-900 border border-neutral-800 text-xs font-mono text-neutral-300">
            #{tag}
          </span>
        ))}
      </footer>
    )}
  </article>
</BaseLayout>
