---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsListItem from '../../components/NewsListItem.astro';
import { getPath } from '../../utils/url';

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  const categories = Array.from(new Set(allNews.map((item) => item.data.category)));

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      articles: allNews
        .filter((item) => item.data.category === category)
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    },
  }));
}

const { category, articles } = Astro.props;
---

<BaseLayout
  title={`${category} News & Analysis | Neural Pulse`}
  description={`Autonomous dispatches, technical breakthroughs, and research papers covering ${category}.`}
>
  <div class="max-w-4xl mx-auto py-4">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] mb-6 border-b border-[var(--border-subtle)] pb-3">
      <a href={getPath('/')} class="hover:text-[var(--accent-editorial)] transition-colors">← Back to Newsroom</a>
      <span>/</span>
      <a href={getPath('/categories/')} class="text-[var(--text-muted)] hover:text-[var(--text-headline)] transition-colors">Categories</a>
      <span>/</span>
      <span class="text-[var(--text-headline)]">{category}</span>
    </nav>

    <header class="mb-10 border-b border-[var(--border-subtle)] pb-6">
      <div class="text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider mb-2">
        Category Archives
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-headline)] tracking-tight font-newspaper">
        {category}
      </h1>
      <p class="text-sm font-mono text-[var(--text-muted)] mt-2">
        Showing {articles.length} dispatches curated by Neural Pulse AI
      </p>
    </header>

    <div class="divide-y divide-[var(--border-subtle)]">
      {articles.map((article) => (
        <NewsListItem
          title={article.data.title}
          description={article.data.description}
          slug={article.id.replace(/\.md$/, '')}
          pubDate={article.data.pubDate}
          category={article.data.category}
          sourceName={article.data.sourceName}
          sourceUrl={article.data.sourceUrl}
          keyTakeaways={article.data.keyTakeaways}
          isWeeklyDigest={article.data.isWeeklyDigest}
        />
      ))}
    </div>
  </div>
</BaseLayout>
