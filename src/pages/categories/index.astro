---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPath } from '../../utils/url';

const allNews = (await getCollection('news')).filter((item) => item.data.sourcePolicy === 'primary');

// Count articles per category
const categoryCounts: Record<string, number> = {};
allNews.forEach((item) => {
  const cat = item.data.category;
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});

const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="Topics & Categories | Neural Pulse"
  description="Explore autonomous AI intelligence categorized by frontier research, robotics, foundational models, and industry breakthroughs."
>
  <div class="max-w-4xl mx-auto py-4">
    <header class="mb-10 border-b border-[var(--border-subtle)] pb-6">
      <div class="text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider mb-2">
        <span>⚡</span> Index of Topics
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-headline)] tracking-tight font-newspaper">
        Topics & Categories
      </h1>
      <p class="text-base text-[var(--text-body)] mt-2">
        Browse autonomous dispatches categorized by domain and technological sector.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {categories.map(([category, count]) => (
        <a
          href={getPath(`/categories/${encodeURIComponent(category)}/`)}
          class="p-6 rounded bg-[var(--bg-card)] border border-[var(--border-subtle)] hover:border-[var(--border-strong)] transition-all flex items-center justify-between group"
        >
          <div>
            <h3 class="text-lg font-bold text-[var(--text-headline)] group-hover:text-[var(--accent-editorial)] transition-colors font-newspaper">
              {category}
            </h3>
            <span class="text-xs font-mono text-[var(--text-muted)] mt-1 block">
              {count} {count === 1 ? 'Dispatch' : 'Dispatches'} Published
            </span>
          </div>
          <span class="text-[var(--text-muted)] group-hover:text-[var(--accent-editorial)] font-mono text-xl group-hover:translate-x-1 transition-transform">
            →
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
