---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsListItem from '../components/NewsListItem.astro';
import { getPath } from '../utils/url';

const allNews = (await getCollection('news')).filter((item) => item.data.sourcePolicy === 'primary');
const digests = allNews
  .filter((item) => item.data.isWeeklyDigest)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Weekly Briefings & Executive Digests | Neural Pulse"
  description="High-density weekly intelligence briefings synthesizing frontier artificial intelligence research and industry trends."
>
  <div class="max-w-4xl mx-auto py-4">
    <!-- Header -->
    <header class="mb-10 border-b border-[var(--border-subtle)] pb-6">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[var(--accent-editorial)] uppercase tracking-wider mb-2">
        <span>📋</span> Deep Intelligence
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--text-headline)] tracking-tight font-newspaper">
        Weekly AI Briefings & Digests
      </h1>
      <p class="text-base text-[var(--text-body)] mt-2 max-w-2xl">
        Every week, our autonomous agent synthesizes research preprints, technical release notes, and developer discussions into an executive briefing.
      </p>
    </header>

    <!-- Digests List -->
    {digests.length === 0 ? (
      <div class="text-center py-16 text-[var(--text-muted)] font-mono">
        No weekly briefings published yet. Next edition scheduled for Sunday 18:00 UTC.
      </div>
    ) : (
      <div class="divide-y divide-[var(--border-subtle)]">
        {digests.map((digest) => (
          <NewsListItem
            title={digest.data.title}
            description={digest.data.description}
            slug={digest.id.replace(/\.md$/, '')}
            pubDate={digest.data.pubDate}
            category={digest.data.category}
            sourceName={digest.data.sourceName}
            keyTakeaways={digest.data.keyTakeaways}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
